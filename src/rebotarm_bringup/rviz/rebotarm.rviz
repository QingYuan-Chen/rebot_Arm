# reBotArm 基础可视化布局(RViz2 配置文件).
#
# 用途:供基础启动文件(硬件直连或键盘遥操作)加载,只做"看"-显示机械臂模型与
# 关键坐标系,不含任何运动规划交互面板,因此也不提供拖动末端执行规划的能力.
#
# 外部依赖:需要机器人状态发布器按 URDF 发布 TF,并发布 /robot_description;
# 模型订阅的关节状态话题在启动文件里被重映射为指定的可视化关节状态话题.
#
# 坐标系约定:固定坐标系固定为 base_link(机械臂底座),其余显示都换算到该坐标系下.

# 面板列表:只保留左侧的 Displays(显示项)面板,便于运行时逐项开关显示
Panels:
  - Class: rviz_common/Displays
# 可视化管理器:定义显示插件列表与全局选项
Visualization Manager:
  # 插件类名,空串表示使用 RViz 默认管理器
  Class: ""
  # 显示插件列表:每一项对应 RViz 里的一个显示条目
  Displays:
    # 地面网格:提供空间尺度参照与平面位置感,无物理含义
    - Class: rviz_default_plugins/Grid
      # 是否启用该显示;true 表示加载配置后立即可见
      Enabled: true
      # 显示项名称,仅用于界面标识,改名不影响功能
      Name: Grid
    # 机器人模型:按机器人描述在 RViz 中绘制机械臂与夹爪
    - Class: rviz_default_plugins/RobotModel
      # 机器人描述话题:由机器人状态发布器提供,值取 URDF 文本
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    # TF 坐标系显示:绘制坐标轴与父子关系,用于核对手眼标定与工具坐标系
    - Class: rviz_default_plugins/TF
      Enabled: true
      # 坐标系超时(秒):某坐标系超过该时长没有更新就被视为过期,停止绘制其变换,
      # 避免显示残留的旧位姿;调小更敏感,但短暂的通信抖动会造成显示闪烁
      Frame Timeout: 15
      # 逐坐标系开关:All Enabled=false 时只显示下面显式打开的那几个
      Frames:
        # 关闭全部坐标系显示,再按需打开,避免机械臂内部的中间坐标系刷屏
        All Enabled: false
        # 底座坐标系:作为固定坐标系始终可见,无需重复绘制其坐标轴
        base_link:
          Value: false
        # 末端法兰坐标系(手臂最后一个 link):用于核对末端位姿
        end_link:
          Value: true
        # 工具中心点坐标系:夹爪抓取参考点,用于核对 TCP 标定结果
        grasp_tcp:
          Value: true
      # 坐标系标记的缩放比例(米):同为 TF 箭头与坐标轴的长度基准;
      # 0.08 适配桌面级机械臂的尺度,调大会显得拥挤,调小会看不清方向
      Marker Scale: 0.08
      # 显示项名称:明确标出本显示只关心末端相关坐标系
      Name: TCP TF
      # 绘制坐标系之间的箭头连线,直观体现父子关系
      Show Arrows: true
      # 绘制每个坐标系的坐标轴,方向即坐标系朝向
      Show Axes: true
      # 显示坐标系名称文字
      Show Names: true
      # 坐标系树:此处为空映射,实际层级由 TF 运行时数据决定
      Tree:
        base_link:
          {}
      # 刷新周期(毫秒);0 表示每个渲染帧都刷新(即全速跟随),动态场景下更流畅
      Update Interval: 0
  # 可视化管理器总开关:false 会让整个 3D 视图停止渲染
  Enabled: true
  # 全局选项:所有显示共用的设置
  Global Options:
    # 固定坐标系:所有显示内容都换算到该坐标系下绘制;改为其他坐标系会连带旋转整个视图
    Fixed Frame: base_link
  # 本配置树的名称,仅用于标识
  Name: root
  # 工具栏:MoveCamera 用于旋转,平移和缩放 RViz 视角,不会改变机械臂关节状态.
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
