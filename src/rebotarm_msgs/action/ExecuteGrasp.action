# ── Goal：一次抓取任务的目标，可用"标签"或"位姿"二选一（或同时给出）指定 ──
# 目标类别名，需与 Detection2D.class_name / GraspCandidate.class_name 匹配（例如 "bottle"）。
string target_label
# 目标位姿，位置单位 m，姿态为四元数；坐标系由服务端约定。
geometry_msgs/Pose target_pose
# 为 true 时使用 target_label 做"按标签找目标"的抓取（视觉侧负责给出候选）。
bool use_label
# 为 true 时使用 target_pose 做"按位姿抓取"（跳过目标识别，直接抓该位姿）。
bool use_pose
---
# ── Result：本次抓取的终局结果 ────────────────────────────────────
# 是否成功完成抓取（含接近、闭合与抓取校验）。
bool success
# 结果说明（英文短句），失败时为失败原因。
string message
---
# ── Feedback：执行阶段与细节 ─────────────────────────────────────
# 阶段名（字符串枚举），描述抓取推进到哪一步（例如识别、规划、接近、闭合、回撤）。
string state
# 阶段补充说明：当前目标/步骤的细节文本，无内容时为空串。
string detail
