<?xml version="1.0" encoding="utf-8"?>
<!--
  本文件由本仓库 Apache-2.0 的 rebotarm.urdf 经 MuJoCo 转换而来，随后裁剪为
  可移植的"视觉 + 运动学"基线模型：只保留网格几何与关节链，力/接触/限位等物理参数
  由仿真包的模型档位构建流程在加载时注入（见同包 mujoco_model_profile）。
  未使用任何外部（HJX）来源资产。

  单位与坐标系约定：长度 m、角度 rad（见 compiler angle="radian"）。
  关节链：base_link（固定基座）→ link1 → link2 → link3 → link4 → link5 → link6
          → end_link（夹爪基座）→ left_finger_link / right_finger_link。
  每个 body 的 pos/quat 都是相对父 body 的位姿，改动会移动整条下游链。
-->
<mujoco model="reBotArm">
  <!-- 角度统一用弧度；惯量由几何体自动推算，且只用 group=4 的碰撞代理几何算，
       避免视觉网格的密度设定污染质量属性。 -->
  <compiler angle="radian" inertiafromgeom="auto" inertiagrouprange="4 4"/>
  <!-- timestep=0.0025 s 即 400 Hz 物理步长；求解器为 Newton，稠密雅可比（本模型自由
       度少，稠密更快更稳），椭圆摩擦锥更接近真实滑动；iterations/tolerance 为迭代
       上限与收敛容差，容差收紧会变慢但接触更准。 -->
  <option timestep="0.0025" iterations="50" tolerance="1e-10" solver="Newton" jacobian="dense" cone="elliptic"/>
  <asset>
    <!-- 网格资源按文件名引用，实际 STL 位于运动规划配置包的 meshes 目录；
         这些路径是相对的，加载前会被补成绝对路径。 -->
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link1" file="link1.STL"/>
    <mesh name="link2" file="link2.STL"/>
    <mesh name="link3" file="link3.STL"/>
    <mesh name="link4" file="link4.STL"/>
    <mesh name="link5" file="link5.STL"/>
    <mesh name="link6" file="link6.STL"/>
    <mesh name="gripper_base" file="gripper_base.stl"/>
    <mesh name="left_finger" file="left_finger.stl"/>
    <mesh name="right_finger" file="right_finger.stl"/>
  </asset>
  <worldbody>
    <!-- 基座：固定在世界坐标系原点的 body，rgba 为灰色显示材质。 -->
    <body name="base_link">
      <geom type="mesh" mesh="base_link" rgba="0.62745 0.62745 0.62745 1"/>
      <!-- link1（第一轴/腰转）：绕竖直 z 轴旋转，位置限位 ±2.8 rad；damping=6 为关节
           粘性阻尼，actuatorfrcrange=±27 N·m 为该关节的力矩上限（与 URDF 的 effort 一致）。 -->
      <body name="link1" pos="-8.416e-05 0 0.08465">
        <inertial pos="0.000113615 -0.00061632 0.0236476" quat="0.672066 0.672066 0.219836 -0.219836" mass="0.1613" diaginertia="0.000272817 0.000213413 0.00015464"/>
        <joint name="joint1" axis="0 0 1" range="-2.8 2.8" damping="6" actuatorfrcrange="-27 27"/>
        <geom type="mesh" mesh="link1" rgba="0.627451 0.627451 0.627451 1"/>
        <!-- link2（大臂）：绕 -z 轴旋转，range 为 [-3.14, 0.02] rad，靠近 0 的一侧留
             0.02 rad 余量作为机械止挡；力矩上限 ±27 N·m。 -->
        <body name="link2" pos="0.020084 0.031625 0.05555" quat="0.707105 -0.707108 0 0">
          <inertial pos="-0.132256 -0.0030617 -0.0308307" quat="0.00176765 0.707354 0.00179466 0.706855" mass="1.3266" diaginertia="0.0128139 0.0125599 0.000733734"/>
          <joint name="joint2" axis="0 0 -1" range="-3.14 0.02" damping="6" actuatorfrcrange="-27 27"/>
          <geom type="mesh" mesh="link2" rgba="0.627451 0.627451 0.627451 1"/>
          <!-- link3（小臂）：绕 z 轴旋转，range [-3.14, 0] rad，肘部只能单向弯曲。 -->
          <body name="link3" pos="-0.264 0 0">
            <inertial pos="0.12104 -0.0536211 -0.0310138" quat="-0.00138181 0.704593 0.00278372 0.709605" mass="0.8353" diaginertia="0.00648251 0.00632715 0.000467564"/>
            <joint name="joint3" axis="0 0 1" range="-3.14 0" damping="6" actuatorfrcrange="-27 27"/>
            <geom type="mesh" mesh="link3" rgba="0.627451 0.627451 0.627451 1"/>
            <!-- link4（腕部第一轴）：阻尼降到 2、力矩上限 ±7 N·m，属小负载手腕段。 -->
            <body name="link4" pos="0.2426 -0.054 -0.001625">
              <inertial pos="0.0608201 -0.0511712 -0.0302995" quat="0.619751 0.601248 0.365808 0.347267" mass="0.52" diaginertia="0.000889485 0.000667165 0.000323211"/>
              <joint name="joint4" axis="0 0 1" range="-1.87 1.57" damping="2" actuatorfrcrange="-7 7"/>
              <geom type="mesh" mesh="link4" rgba="0.627451 0.627451 0.627451 1"/>
              <!-- link5（腕部第二轴）：±1.57 rad 对称摆转，同样 ±7 N·m。 -->
              <body name="link5" pos="0.078308 -0.0375 -0.03" quat="0.707105 -0.707108 0 0">
                <inertial pos="-0.00502802 1.73866e-06 0.0386233" quat="0.644154 0.196994 0.180566 0.716697" mass="0.383" diaginertia="0.000217429 0.000212237 0.000157335"/>
                <joint name="joint5" axis="0 0 1" range="-1.57 1.57" damping="2" actuatorfrcrange="-7 7"/>
                <geom type="mesh" mesh="link5" rgba="0.627451 0.627451 0.627451 1"/>
                <!-- link6（末端法兰）：可整圈旋转 ±3.14 rad，±7 N·m。 -->
                <body name="link6" pos="0.028008 0 0.04" quat="0.707105 0 0.707108 0">
                  <inertial pos="5.50089e-06 -3.71802e-05 0.0578217" quat="0.999981 -0.00127532 -0.000304602 -0.00594064" mass="0.8663" diaginertia="0.00127909 0.000983777 0.000513199"/>
                  <joint name="joint6" axis="0 0 1" range="-3.14 3.14" damping="2" actuatorfrcrange="-7 7"/>
                  <geom type="mesh" mesh="link6" rgba="0.627451 0.627451 0.627451 1"/>
                  <!-- end_link：夹爪基座，无关节（固定在 link6 末端），是 TCP 的基准体。 -->
                  <body name="end_link" pos="0 0 0.15539" quat="3.27579e-05 0.707108 -3.27581e-05 0.707105">
                    <geom type="mesh" mesh="gripper_base" rgba="0.627451 0.627451 0.627451 1"/>
                    <!-- 左指：沿自身 +y 方向滑移的棱柱关节，行程 0～0.045 m。
                         armature=0.243 为折算到手指上的等效质量，damping=40 抑制接触振荡。 -->
                    <body name="left_finger_link">
                      <joint name="left_finger" type="slide" axis="0 1 0" range="0 0.045" armature="0.243" damping="40"/>
                      <geom type="mesh" mesh="left_finger" rgba="0.627451 0.627451 0.627451 1"/>
                    </body>
                    <!-- 右指：与左指对称，沿同一 y 轴反向滑移，行程 -0.045～0 m。
                         两根手指的行程合起来即最大开口 0.09 m。 -->
                    <body name="right_finger_link">
                      <joint name="right_finger" type="slide" axis="0 1 0" range="-0.045 0" armature="0.243" damping="40"/>
                      <geom type="mesh" mesh="right_finger" rgba="0.627451 0.627451 0.627451 1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <!-- 手指耦合约束：polycoef="0 -1 0 0 0" 表示 left_finger = -1 × right_finger，
       即两指位置始终镜像对称，只需控制其中一根即可保证夹爪居中开合。 -->
  <equality>
    <joint joint1="left_finger" joint2="right_finger" polycoef="0 -1 0 0 0"/>
  </equality>
  <!-- 位置执行器：6 个臂关节各一个，夹爪只驱动左指（右指由上面的等式约束跟随）。
       ctrlrange/forcerange/kp/kv 等控制参数不在此处写死，而由模型档位构建流程按
       标定文件注入，保证仿真限位与 URDF 力矩上限一致。 -->
  <actuator>
    <position name="joint1" joint="joint1"/>
    <position name="joint2" joint="joint2"/>
    <position name="joint3" joint="joint3"/>
    <position name="joint4" joint="joint4"/>
    <position name="joint5" joint="joint5"/>
    <position name="joint6" joint="joint6"/>
    <position name="gripper" joint="left_finger"/>
  </actuator>
</mujoco>
