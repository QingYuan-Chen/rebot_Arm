<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面工作台标准场景：机器人 + 桌子 + 供本地接触/Pick 验证的方块。
     机器人本体由同目录的 robot.xml 提供，本文件只负责环境、光照与初始关键帧。
     单位：长度 m、角度 rad。 -->
<mujoco model="rebotarm_tabletop_scene">
  <include file="robot.xml"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <!-- 自由相机与被动物体自动取景的统计中心（工作台附近）与范围（m）。
       只影响 MuJoCo 查看器的默认视角，不影响物理。 -->
  <statistic center="0.15 0 0.18" extent="0.8"/>
  <visual>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.65 0.65 0.65" specular="0.15 0.15 0.15"/>
    <global azimuth="135" elevation="-22"/>
  </visual>
  <worldbody>
    <light name="key_light" pos="0.2 -0.5 1.5" dir="0.1 0.2 -1" directional="true"/>
    <camera name="fixed_camera" pos="0.85 -0.90 0.55" xyaxes="0.727 0.686 0 -0.245 0.260 0.934"/>
    <!-- Viewer-only Cartesian target. A mocap body can be Ctrl-dragged
         without adding mass, actuation, or contact forces. -->
    <body name="ee_target" mocap="true" pos="0.2188 0 0.4067">
      <geom name="ee_target_handle" type="sphere" size="0.014"
            rgba="0.15 0.95 0.35 0.75" group="1"
            contype="0" conaffinity="0"/>
      <geom name="ee_target_axis_x" type="capsule" size="0.0025"
            fromto="0 0 0 0.055 0 0" rgba="0.95 0.15 0.12 0.95" group="1"
            contype="0" conaffinity="0"/>
      <geom name="ee_target_axis_y" type="capsule" size="0.0025"
            fromto="0 0 0 0 0.055 0" rgba="0.12 0.90 0.25 0.95" group="1"
            contype="0" conaffinity="0"/>
      <geom name="ee_target_axis_z" type="capsule" size="0.0025"
            fromto="0 0 0 0 0 0.055" rgba="0.15 0.35 1.0 0.95" group="1"
            contype="0" conaffinity="0"/>
      <site name="ee_target_frame" type="sphere" size="0.004" group="1"
            rgba="0.2 1 0.4 0.9"/>
    </body>
    <geom name="floor" type="plane" pos="0 0 -0.75" size="2 2 0.1" rgba="0.18 0.2 0.22 1" contype="1" conaffinity="1"/>
    <body name="table" pos="0.20 0 -0.025">
      <geom name="table_top" type="box" size="0.55 0.45 0.025" rgba="0.48 0.34 0.22 1" contype="1" conaffinity="1" friction="0.9 0.02 0.001"/>
      <geom name="table_leg_front_left" type="box" pos="0.48 0.38 -0.375" size="0.035 0.035 0.35" rgba="0.34 0.23 0.14 1" contype="1" conaffinity="1"/>
      <geom name="table_leg_front_right" type="box" pos="0.48 -0.38 -0.375" size="0.035 0.035 0.35" rgba="0.34 0.23 0.14 1" contype="1" conaffinity="1"/>
      <geom name="table_leg_back_left" type="box" pos="-0.48 0.38 -0.375" size="0.035 0.035 0.35" rgba="0.34 0.23 0.14 1" contype="1" conaffinity="1"/>
      <geom name="table_leg_back_right" type="box" pos="-0.48 -0.38 -0.375" size="0.035 0.035 0.35" rgba="0.34 0.23 0.14 1" contype="1" conaffinity="1"/>
    </body>
    <body name="test_cube" pos="0.28 0 0.04">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.08" diaginertia="0.0000107 0.0000107 0.0000107"/>
      <geom name="test_cube_geom" type="box" size="0.02 0.02 0.02" rgba="0.9 0.25 0.12 1" contype="1" conaffinity="1" friction="1.0 0.02 0.001"/>
    </body>
  </worldbody>
  <keyframe>
    <key name="home" qpos="0 -0.8 -1.0 0.3 0 0 0.03 -0.03 0.28 0 0.04 1 0 0 0"/>
  </keyframe>
</mujoco>
