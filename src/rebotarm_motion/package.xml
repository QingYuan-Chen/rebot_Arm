<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  运动包（rebotarm_motion）的包清单，package format 3。

  职责：轨迹生成、规划客户端适配、轨迹重定时、速度/加速度/加加速度校验、回放运行时跟踪守卫、
  碰撞预检、示教回放起始对齐与关节轨迹构造工具。本包可以调用规划服务与控制器动作，但不得
  直接访问电机 SDK，硬件访问统一收敛在底层硬件控制包里。

  说明：下面的依赖都是运行期声明（exec_depend）。本清单同时也是测试检查"源码中出现的包名
  必须已在此声明"的依据，且包依赖图必须保持无环，因此不要随意增删或改动顺序。
-->
<package format="3">
  <name>rebotarm_motion</name>
  <version>0.1.0</version>
  <description>Motion generation, retiming, validation, and safety utilities for reBotArm.</description>
  <maintainer email="support@example.com">reBotArm Maintainers</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具依赖：本包是纯 Python 包，构建类型为 ament_python（见文件末尾 export/build_type）。 -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- geometry_msgs：位姿/点/四元数等几何消息类型（目标位姿与规划请求）。 -->
  <exec_depend>geometry_msgs</exec_depend>
  <!-- builtin_interfaces：时间与时长类型，用于轨迹点的时间戳。 -->
  <exec_depend>builtin_interfaces</exec_depend>
  <!-- pinocchio：刚体运动学/动力学库。当前包内源码未见直接 import（动力学计算主要在硬件
       控制包使用），此处按清单保留声明，不对具体调用点作断言。 -->
  <exec_depend>pinocchio</exec_depend>
  <!-- ruckig：加加速度（jerk）受限的在线轨迹生成库，用作可选的重定时后端。运行时探测能否
       导入该模块，不可用时自动回落到内置重定时实现，因此缺失它不会让功能失败。 -->
  <exec_depend>ruckig</exec_depend>
  <!-- control_msgs：控制器动作接口定义（关节轨迹跟随动作的 Goal/Result/Feedback）。 -->
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <!-- moveit_msgs：运动规划服务与约束消息类型（规划请求、关节/位置/姿态约束）。 -->
  <exec_depend>moveit_msgs</exec_depend>
  <!-- python3-yaml：YAML 解析库的系统依赖键名；源码中通过 import yaml 读取参数文件。 -->
  <exec_depend>python3-yaml</exec_depend>
  <!-- rclpy：客户端库（节点、参数、话题订阅、动作客户端、执行器）。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- rebotarm_msgs：本仓库自定义的服务/消息接口（例如位姿执行服务）。 -->
  <exec_depend>rebotarm_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <!-- sensor_msgs：关节状态等传感器消息。 -->
  <exec_depend>sensor_msgs</exec_depend>
  <!-- shape_msgs：碰撞检测用的几何实体形状（实体基元）。 -->
  <exec_depend>shape_msgs</exec_depend>
  <!-- std_msgs：基础消息包装类型；当前包源码未直接 import，属保留声明。 -->
  <exec_depend>std_msgs</exec_depend>
  <!-- std_srvs：标准服务类型（Trigger 服务用于按需触发一次动作）。 -->
  <exec_depend>std_srvs</exec_depend>
  <!-- trajectory_msgs：关节轨迹消息，构造并下发给控制器。 -->
  <exec_depend>trajectory_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
